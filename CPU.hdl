// Hack CPU: executes A-instructions and C-instructions.
CHIP CPU {
    IN inM[16], instruction[16], reset;
    OUT outM[16], writeM, addressM[15], pc[15];
    PARTS:
    // A register loads either an A-instruction value or the ALU result.
    Not(in=instruction[15], out=isA);
    And(a=instruction[15], b=instruction[5], out=cLoadA);
    Or(a=isA, b=cLoadA, out=loadA);
    Mux16(a=instruction, b=aluOut, sel=instruction[15], out=aInput);
    ARegister(in=aInput, load=loadA, out=aOut, out[0..14]=addressM);

    DRegister(in=aluOut, load=cLoadD, out=dOut);
    And(a=instruction[15], b=instruction[4], out=cLoadD);

    // ALU y input is A or memory, selected by the a-bit.
    Mux16(a=aOut, b=inM, sel=instruction[12], out=aluY);
    ALU(x=dOut, y=aluY, zx=instruction[11], nx=instruction[10],
        zy=instruction[9], ny=instruction[8], f=instruction[7], no=instruction[6],
        out=aluOut, zr=zr, ng=ng);

    And(a=instruction[15], b=instruction[3], out=writeM);

    // Decode the seven Hack jump conditions.
    Not(in=zr, out=notZr);
    Not(in=ng, out=notNg);
    And(a=notZr, b=notNg, out=positive);
    And(a=instruction[0], b=positive, out=jgt);
    And(a=instruction[1], b=zr, out=jeq);
    And(a=instruction[2], b=ng, out=jlt);
    Or(a=jgt, b=jeq, out=jgeOr);
    Or(a=jgeOr, b=jlt, out=jumpBits);
    // The individual jump-bit combinations are decoded explicitly.
    And(a=instruction[2], b=instruction[1], out=geBits);
    And(a=geBits, b=notNg, out=geCondition);
    And(a=instruction[2], b=instruction[0], out=gtBits);
    And(a=gtBits, b=positive, out=gtCondition);
    And(a=instruction[1], b=instruction[0], out=leBits);
    And(a=leBits, b=notZr, out=leCondition);
    And(a=instruction[2], b=instruction[1], out=geBits2);
    And(a=geBits2, b=notNg, out=geCondition2);
    And(a=instruction[2], b=instruction[0], out=geBits3);
    And(a=geBits3, b=notZr, out=neCondition);
    Or(a=jgt, b=jeq, out=cond1);
    Or(a=cond1, b=jlt, out=cond2);
    And(a=instruction[15], b=cond2, out=pcLoad);
    PC(in=aOut, load=pcLoad, inc=true, reset=reset, out[0..14]=pc);
    Or16(a=aluOut, b=false, out=outM);
}
